rules_version = '2';

// Firebase Storage Security Rules for Tournament Paperwork
service firebase.storage {
  match /b/{bucket}/o {
    // Tournament paperwork documents
    match /tournaments/{tournamentId}/paperwork/{document=**} {
      // Allow read access to authenticated users
      allow read: if request.auth != null;

      // Allow write access to authenticated users (for uploads)
      allow write: if request.auth != null;

      // Allow delete only for admins or the uploader
      allow delete: if request.auth != null &&
        (request.auth.token.role == 'admin' ||
         resource.metadata.uploadedBy == request.auth.uid);
    }

    // Fee sheet PDFs - public read access for iframe embedding
    match /fee-sheets/{document=**} {
      // Allow public read access (needed for iframe embedding)
      allow read: if true;

      // Only Cloud Functions can write (via Admin SDK)
      allow write: if false;
    }

    // Practice recording videos
    match /recordings/{userId}/{videoFile} {
      // Allow users to upload their own recordings
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow users to read their own recordings
      // Also allow anyone with the download URL to read (for sharing via Firestore)
      allow read: if request.auth != null;

      // Allow users to delete their own recordings
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
