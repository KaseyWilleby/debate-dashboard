rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSameTeam(teamId) {
      return isAuthenticated() && getUserData().teamId == teamId;
    }

    function isCoach() {
      return hasRole('coach') || hasRole('superadmin');
    }

    function isParentOf(studentId) {
      let user = getUserData();
      return user.childIds != null && studentId in user.childIds;
    }

    function isChildOf(parentId) {
      let user = getUserData();
      return user.parentIds != null && parentId in user.parentIds;
    }

    // Users collection
    match /users/{userId} {
      // Allow all authenticated users to read user profiles
      // This is needed for team member listings, messaging, etc.
      // Individual document access still protected by ownership on writes
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isOwner(userId) ||
        isCoach()
      );

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (
          isOwner(userId) ||
          isParentOf(userId) // Parents can read their children's notifications
        );
        allow write: if isAuthenticated() && (
          isOwner(userId) ||
          isCoach()
        );
      }
    }

    // Teams collection
    match /teams/{teamId} {
      // Allow ALL users (even unauthenticated) to read teams
      // This is needed for signup page where users select their team
      // Team data (names, slugs) isn't sensitive
      allow read: if true;
      allow write: if isCoach();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        // Parents can read conversations their children are in
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds != null &&
        resource.data.participants.hasAny(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds)
      );

      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        isSameTeam(request.resource.data.teamId);

      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy ||
        isCoach()
      );

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          // Parents can read messages in conversations their children are in
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds != null &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny(
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.childIds
          )
        );

        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.auth.uid == request.resource.data.senderId;

        allow update: if isAuthenticated() &&
          request.auth.uid == resource.data.senderId;

        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.senderId ||
          isCoach()
        );
      }
    }

    // Device tokens for push notifications
    match /deviceTokens/{tokenId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Notification preferences
    match /notificationPreferences/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Parent monitoring settings
    match /parentMonitoringSettings/{parentId} {
      allow read: if isAuthenticated() && isOwner(parentId);
      allow write: if isAuthenticated() && isOwner(parentId);
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      // Allow all authenticated users to read tournaments
      // Client-side filtering by teamId still required
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Sessions
    match /sessions/{sessionId} {
      // Allow all authenticated users to read sessions
      // Client-side filtering by teamId required
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isSameTeam(request.resource.data.teamId);
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.hostId ||
        request.auth.uid == resource.data.clientId ||
        isCoach()
      );
      allow delete: if isCoach();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow create: if isAuthenticated() && isSameTeam(request.resource.data.teamId);
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.providerId ||
        request.auth.uid == resource.data.attendeeId ||
        isCoach()
      );
      allow delete: if isCoach();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow write: if isCoach();
    }

    // Tournament Results
    match /tournamentResults/{resultId} {
      // Allow all authenticated users to read tournament results
      // Students need to see their own and teammates' results
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Resources (Learning Hub)
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Entries (Tournament registrations)
    match /entries/{entryId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isOwner(resource.data.studentId) ||
        isCoach()
      );
      allow delete: if isCoach();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow write: if isCoach();
    }

    // Submissions
    match /submissions/{submissionId} {
      // Allow all authenticated users to read submissions
      // This is needed for peer feedback assignments where students review each other's work
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        isOwner(request.resource.data.studentId);
      allow update: if isAuthenticated() && (
        isOwner(resource.data.studentId) ||
        isCoach()
      );
      allow delete: if isCoach();
    }

    // Scraped Tournaments (from tabroom.com)
    match /scrapedTournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Saved Speeches (practice recordings)
    match /savedSpeeches/{speechId} {
      // Allow all authenticated users to read speeches
      // Individual document access still protected by ownership on update/delete
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isCoach()
      );
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isCoach()
      );
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow write: if isCoach();
    }

    // Appointment Windows
    match /appointmentWindows/{windowId} {
      allow read: if isAuthenticated() && (
        isSameTeam(resource.data.teamId) ||
        isCoach()
      );
      allow write: if isCoach();
    }

    // Officer Availability
    match /officerAvailability/{availabilityId} {
      // Allow all authenticated users to read availability
      // This is needed for students to book appointments
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Congress Dockets
    match /congressDockets/{docketId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Practice Rounds
    match /practiceRounds/{roundId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.createdBy) ||
        isCoach()
      );
    }

    // Metadata (system metadata)
    match /metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isCoach();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
