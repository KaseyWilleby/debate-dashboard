/**
 * @fileoverview Firestore Security Rules for Debate Dashboard.
 *
 * Core Philosophy:
 * This ruleset enforces a multi-tenant role-based access control with team isolation.
 * Superadmins can access all teams. Coaches can manage their team. Users can only access
 * their own team's data.
 *
 * Data Structure:
 * - /teams/{teamId}: Stores team information
 * - /users/{userId}: Stores individual user profiles (with teamId)
 * - /sessions/{sessionId}: Stores session data (team-scoped)
 * - /tournaments/{tournamentId}: Stores tournament information (team-scoped)
 * - /savedSpeeches/{speechId}: Stores user speeches (team-scoped)
 * - /writtenSpeeches/{speechId}: Stores written speeches (team-scoped)
 * - /debateCases/{caseId}: Stores debate cases (team-scoped)
 * - /debateTopics/{topicId}: Stores debate topics (team-scoped)
 * - /congressDockets/{docketId}: Stores congress dockets (team-scoped)
 * - /practiceRounds/{roundId}: Stores practice rounds (team-scoped)
 * - /tournamentResults/{resultId}: Stores tournament results (team-scoped)
 *
 * Key Security Decisions:
 * - Superadmin users (role === 'superadmin') can access ALL teams and data
 * - Coach users (role === 'coach') can manage their own team's data and users
 * - Varsity/Novice users can only access their own team's data
 * - All data is team-scoped using teamId field
 * - Users can only manage their own profile (except coaches/superadmins)
 *
 * Last updated: 2026-09-21
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to team documents.
     * @path /teams/{teamId}
     * Superadmins can manage all teams. Users can read their own team.
     * Unauthenticated users can list active teams for signup dropdown.
     */
    match /teams/{teamId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || getUserTeamId() == teamId);
      allow list: if request.auth == null || isSignedIn(); // Allow unauthenticated users and all authenticated users to list teams
      allow create: if isSuperAdmin() || isSuperAdminEmail() || request.auth == null; // Allow unauthenticated users to create new teams during signup
      allow delete: if isSuperAdmin() || isSuperAdminEmail();
      allow update: if isSuperAdmin() || isSuperAdminEmail() || (isCoach() && getUserTeamId() == teamId);
    }

    /**
     * @description Manages access to user profiles.
     * @path /users/{userId}
     * Superadmins can access all users. Coaches can access users in their team.
     * Users can access other users in their team (for display purposes).
     * Unauthenticated users can query by username for login purposes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isSignedIn() || request.auth == null; // Allow authenticated users and unauthenticated username lookup for login
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin() || isSuperAdminEmail() || (isCoach() && isSameTeam(resource.data.teamId));
      allow delete: if isSuperAdmin() || isSuperAdminEmail();
    }

    /**
     * @description Manages access to session documents.
     * @path /sessions/{sessionId}
     * Users can access sessions in their team. Hosts, clients, coaches, and superadmins can modify.
     * Users can book themselves as clients.
     */
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isSuperAdminEmail() ||
        (request.resource.data.hostId == request.auth.uid && request.resource.data.teamId == getUserTeamId())
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (isSameTeam(resource.data.teamId) && (
          resource.data.hostId == request.auth.uid ||
          resource.data.clientId == request.auth.uid ||
          request.resource.data.clientId == request.auth.uid ||
          isCoach()
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (isSameTeam(resource.data.teamId) && (resource.data.hostId == request.auth.uid || isCoach()))
      );
    }

    /**
     * @description Manages access to tournament documents.
     * @path /tournaments/{tournamentId}
     * Team members can read and update entries. Coaches/superadmins can manage all fields.
     */
    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create, delete: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isCoach() && request.resource.data.teamId == getUserTeamId()));
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (isSameTeam(resource.data.teamId) && isCoach()) ||
        (isSameTeam(resource.data.teamId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries', 'paperwork', 'feeSheet']))
      );
    }

    /**
     * @description Manages access to saved speeches.
     * @path /savedSpeeches/{speechId}
     * Team members can manage their own speeches. Shared speeches are readable within team.
     */
    match /savedSpeeches/{speechId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.get('sharedWith', [])))
      );
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.teamId == getUserTeamId();
      allow update: if isSignedIn() && (isSuperAdmin() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
      allow delete: if isSignedIn() && (isSuperAdmin() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
    }

    /**
     * @description Manages access to written speeches.
     * @path /writtenSpeeches/{speechId}
     */
    match /writtenSpeeches/{speechId} {
      allow get: if isSignedIn() && (
        isSuperAdmin() ||
        (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.get('sharedWith', [])))
      );
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.teamId == getUserTeamId();
      allow update: if isSignedIn() && (isSuperAdmin() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
      allow delete: if isSignedIn() && (isSuperAdmin() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
    }

    /**
     * @description Manages access to debate cases.
     * @path /debateCases/{caseId}
     */
    match /debateCases/{caseId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSignedIn() && (isSuperAdminEmail() || (request.resource.data.ownerId == request.auth.uid && request.resource.data.teamId == getUserTeamId()));
      allow update: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
      allow delete: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isSameTeam(resource.data.teamId) && (resource.data.ownerId == request.auth.uid || isCoach())));
    }

    /**
     * @description Manages access to debate topics.
     * @path /debateTopics/{topicId}
     */
    match /debateTopics/{topicId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isCoach() && request.resource.data.teamId == getUserTeamId()));
    }

    /**
     * @description Manages access to congress dockets.
     * @path /congressDockets/{docketId}
     */
    match /congressDockets/{docketId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create, update, delete: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isCoach() && request.resource.data.teamId == getUserTeamId()));
    }

    /**
     * @description Manages access to practice rounds.
     * @path /practiceRounds/{roundId}
     */
    match /practiceRounds/{roundId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (request.resource.data.teamId == getUserTeamId() && (request.auth.uid in request.resource.data.participants || isCoach()))
      );
      allow update, delete: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (isSameTeam(resource.data.teamId) && (request.auth.uid in resource.data.participants || isCoach()))
      );
    }

    /**
     * @description Manages access to tournament results.
     * @path /tournamentResults/{resultId}
     * Team members can read results from their team. Coaches/superadmins can manage results.
     */
    match /tournamentResults/{resultId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (request.resource.data.teamId == getUserTeamId() && (request.resource.data.userId == request.auth.uid || isCoach()))
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        isSuperAdminEmail() ||
        (isSameTeam(resource.data.teamId) && (resource.data.userId == request.auth.uid || isCoach()))
      );
      allow delete: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || (isSameTeam(resource.data.teamId) && isCoach()));
    }

    /**
     * @description Manages access to invoices.
     * @path /invoices/{invoiceId}
     * Coaches can view their team's invoices. Superadmins can manage all invoices.
     * Unauthenticated users can create invoices (during school registration).
     */
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (isSuperAdmin() || isSuperAdminEmail() || isSameTeam(resource.data.teamId));
      allow list: if isSignedIn(); // Allow listing, application will filter by teamId
      allow create: if isSuperAdmin() || isSuperAdminEmail() || request.auth == null; // Allow unauthenticated during school registration
      allow update, delete: if isSuperAdmin() || isSuperAdminEmail();
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is a superadmin by reading their user document.
     * @return {boolean} True if the user is a superadmin, false otherwise.
     */
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    /**
     * @description Checks if the user is a specific superadmin email (for migration purposes).
     * @return {boolean} True if the user is the superadmin email, false otherwise.
     */
    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'kaseywilleby@gmail.com' ||
        request.auth.token.email == 'kasey.willeby@cfisd.net'
      );
    }

    /**
     * @description Checks if the user is a coach by reading their user document.
     * @return {boolean} True if the user is a coach, false otherwise.
     */
    function isCoach() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    /**
     * @description Gets the current user's teamId from their user document.
     * @return {string} The user's teamId.
     */
    function getUserTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    /**
     * @description Checks if a given teamId matches the current user's teamId.
     * @param {string} teamId - The teamId to compare against the user's teamId.
     * @return {boolean} True if the teamIds match, false otherwise.
     */
    function isSameTeam(teamId) {
      return getUserTeamId() == teamId;
    }
  }
}